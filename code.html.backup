<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>SafeLink | Profile &amp; History</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<style>
    body {
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
    }
    .glass-card {
      background: rgba(23, 31, 51, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(79, 219, 200, 0.1);
    }
    .glass-header {
      background: rgba(11, 19, 38, 0.8);
      backdrop-filter: blur(16px);
    }
    .video-preview-glow {
      box-shadow: 0 0 20px rgba(79, 219, 200, 0.15);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #3c4947;
      border-radius: 10px;
    }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "on-surface": "#dae2fd",
            "error-container": "#93000a",
            "on-background": "#dae2fd",
            "surface": "#0b1326",
            "outline": "#859490",
            "surface-container-low": "#131b2e",
            "surface-container-highest": "#2d3449",
            "tertiary-fixed-dim": "#ffb2b7",
            "outline-variant": "#3c4947",
            "on-secondary-fixed": "#07006c",
            "surface-variant": "#2d3449",
            "secondary-container": "#3131c0",
            "on-secondary-fixed-variant": "#2f2ebe",
            "tertiary-container": "#ff7b88",
            "on-tertiary": "#67001b",
            "secondary-fixed": "#e1e0ff",
            "secondary": "#c0c1ff",
            "on-tertiary-fixed-variant": "#92002a",
            "error": "#ffb4ab",
            "surface-bright": "#31394d",
            "primary": "#4fdbc8",
            "inverse-primary": "#006b5f",
            "primary-fixed-dim": "#4fdbc8",
            "surface-container-lowest": "#060e20",
            "background": "#0b1326",
            "surface-container-high": "#222a3d",
            "on-primary-fixed": "#00201c",
            "on-tertiary-container": "#7a0022",
            "on-surface-variant": "#bbcac6",
            "primary-fixed": "#71f8e4",
            "surface-container": "#171f33",
            "tertiary-fixed": "#ffdadb",
            "surface-dim": "#0b1326",
            "tertiary": "#ffb2b7",
            "on-primary-container": "#00423b",
            "on-primary": "#003731",
            "on-error": "#690005",
            "on-error-container": "#ffdad6",
            "primary-container": "#14b8a6",
            "inverse-on-surface": "#283044",
            "on-tertiary-fixed": "#40000d",
            "on-primary-fixed-variant": "#005048",
            "on-secondary": "#1000a9",
            "secondary-fixed-dim": "#c0c1ff",
            "on-secondary-container": "#b0b2ff",
            "surface-tint": "#4fdbc8",
            "inverse-surface": "#dae2fd"
          },
          "borderRadius": {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          "spacing": {
            "lg": "24px",
            "base": "4px",
            "margin-desktop": "40px",
            "gutter": "16px",
            "sm": "8px",
            "xl": "32px",
            "margin-mobile": "16px",
            "md": "16px",
            "xs": "4px"
          },
          "fontFamily": {
            "headline-md": ["Inter"],
            "label-md": ["Inter"],
            "label-sm": ["Inter"],
            "display-lg": ["Inter"],
            "headline-lg": ["Inter"],
            "headline-lg-mobile": ["Inter"],
            "body-lg": ["Inter"],
            "body-md": ["Inter"]
          },
          "fontSize": {
            "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
            "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
            "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "600"}],
            "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
            "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
            "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
            "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
            "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
          }
        },
      },
    }
  </script>
</head>
<body class="bg-background text-on-surface flex flex-col min-h-screen">
<!-- TopNavBar Implementation -->
<header class="bg-surface/80 dark:bg-surface/80 backdrop-blur-xl docked full-width top-0 sticky z-50 border-b border-outline-variant/10 shadow-sm shadow-md">
<div class="flex justify-between items-center px-lg py-md w-full max-w-7xl mx-auto">
<div class="flex items-center gap-sm">
<span class="material-symbols-outlined text-primary text-3xl" style="font-variation-settings: 'FILL' 1;">shield_person</span>
<h1 class="font-headline-md text-headline-md font-bold text-primary dark:text-primary">SafeLink</h1>
</div>
<nav class="hidden md:flex items-center gap-xl">
<a class="text-on-surface-variant font-medium hover:text-primary transition-colors duration-200 cursor-pointer active:scale-95 transition-transform" href="#">Find Match</a>
<a class="text-on-surface-variant font-medium hover:text-primary transition-colors duration-200 cursor-pointer active:scale-95 transition-transform" href="#">Discovery</a>
<a class="text-on-surface-variant font-medium hover:text-primary transition-colors duration-200 cursor-pointer active:scale-95 transition-transform" href="#">History</a>
</nav>
<div class="flex items-center gap-md">
<button class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-colors">settings</button>
<div class="flex items-center gap-sm px-sm py-xs rounded-full bg-primary-container text-on-primary-container font-bold border-b-2 border-primary pb-1 cursor-pointer active:scale-95 transition-transform">
<div class="w-8 h-8 rounded-full bg-surface-container-highest overflow-hidden border border-primary/20">
<img class="w-full h-full object-cover" data-alt="A professional studio headshot of a person with friendly features, wearing a modern teal blazer. The lighting is soft and cinematic, following a dark mode tech aesthetic with subtle indigo and teal backlighting in a high-end minimalist setting." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCGAJEXUV-eCDoawH2V177qajYS4vWFIUZL2jCR6JjUX8Z5gws3KKjElj_td4rthaWz88uHBHMLZqEA72KfIIKBO68dwriXSF1uEKUHs9hPTTUzJCDD3Tmxcs8d9_6wVxS4DzeHX91KUKH4Xu_2cY9x9SFCw-LvZvefgwKtbQ8yUBgfCHrIXnPUxPRwbPiQg_IHVHyKoEdX_t-LtD0wyM9QF5dl9lfLECZiudIatovZSgctO9dcc5PdFX6qh_OZX01x-eJRrcU"/>
</div>
<span class="font-label-md text-label-md hidden sm:inline">Profile</span>
</div>
</div>
</div>
</header>
<main class="flex-grow w-full max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-xl">
<!-- Hero / Go Back Action -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-xl gap-md">
<div>
<h2 class="font-headline-lg text-headline-lg text-on-surface">Account Overview</h2>
<p class="font-body-md text-body-md text-on-surface-variant">Manage your identity and review recent video interactions.</p>
</div>
<button class="flex items-center gap-sm px-xl py-md bg-primary text-on-primary font-bold rounded-xl hover:shadow-[0_0_20px_rgba(79,219,200,0.4)] transition-all duration-300 group active:scale-95">
<span class="material-symbols-outlined transition-transform group-hover:-translate-x-1">arrow_back</span>
<span class="font-label-md text-label-md">Go Back to Discovery</span>
</button>
</div>
<!-- Bento Grid Layout -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-lg">
<!-- Left Column: User Profile & Devices -->
<div class="lg:col-span-4 space-y-lg">
<!-- Identity Card -->
<div class="glass-card rounded-xl p-lg flex flex-col items-center text-center">
<div class="relative w-32 h-32 mb-md">
<div class="absolute inset-0 bg-primary/20 rounded-full animate-pulse"></div>
<div class="relative w-full h-full rounded-full border-4 border-primary overflow-hidden">
<img class="w-full h-full object-cover" data-alt="A portrait of a creative individual with soft studio lighting, focused gaze, and a slight smile. The background is a blurred dark office with ambient teal and indigo neon lights, matching the high-energy video communication brand identity." src="https://lh3.googleusercontent.com/aida-public/AB6AXuD06wwbv-AzG-yMrptBtMTz3VTL-FQajy1m-AZH6kBkDZH32b-zVpiAjcEeWBUp-kayGj0JixwfnttO6e8XPbM_9W0z16TNG5NNKXlhREMzdb7TOa36OJHdErgx9_CPXs52aWWMF1dC16d6hi55q2rGlUYSrYP9YO-por2rTZku6kZh8K5by3hEjkMmCaUO8ARy6ck5C22Y7uEolSCAcJW9tIgQXWqr1WxuVbYOejk81x5DuyJTbOoa3ggaWgZTBZ-353EqrqI"/>
</div>
<button class="absolute bottom-1 right-1 w-10 h-10 bg-primary text-on-primary rounded-full flex items-center justify-center border-4 border-surface shadow-lg hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-sm">edit</span>
</button>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface">Alex Rivera</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-md">Verified User • Since 2024</p>
<div class="flex gap-sm">
<div class="flex items-center gap-xs px-md py-xs bg-surface-container-high rounded-full border border-outline-variant/30">
<span class="material-symbols-outlined text-primary text-[18px]" style="font-variation-settings: 'FILL' 1;">verified</span>
<span class="text-label-sm font-label-sm text-on-surface">ID Verified</span>
</div>
</div>
</div>
<!-- Hardware Settings -->
<div class="glass-card rounded-xl p-lg">
<h4 class="font-label-md text-label-md font-bold text-primary mb-md flex items-center gap-sm">
<span class="material-symbols-outlined">settings_input_component</span>
            Hardware &amp; Connectivity
          </h4>
<div class="space-y-md">
<!-- Camera Setting -->
<div class="space-y-sm">
<label class="font-label-sm text-label-sm text-on-surface-variant px-1">Camera Input</label>
<div class="flex items-center gap-md bg-surface-container-lowest p-md rounded-lg border border-outline-variant/30 focus-within:border-primary transition-colors">
<span class="material-symbols-outlined text-on-surface-variant">videocam</span>
<select class="bg-transparent border-none text-on-surface font-body-md w-full focus:ring-0 p-0">
<option>Logitech StreamCam Plus</option>
<option>FaceTime HD Camera</option>
<option>OBS Virtual Camera</option>
</select>
</div>
<div class="w-full aspect-video rounded-lg bg-black/40 video-preview-glow overflow-hidden relative border border-outline-variant/20">
<div class="absolute inset-0 flex items-center justify-center text-on-surface-variant/40 flex-col gap-sm">
<span class="material-symbols-outlined text-4xl">visibility</span>
<span class="text-label-sm uppercase tracking-widest font-bold">Preview Active</span>
</div>
<img class="w-full h-full object-cover opacity-60" data-alt="A crisp, high-definition 9:16 portrait video feed preview showing a person in a minimalist home office with warm ambient lighting. The person is framed perfectly for a professional video call, with a soft teal glow reflecting on the side of their face from a monitor." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCPIs5CRCkXlcbz5zuEOTxtgSF7QDiRQzvez-2p7sBUSKxNsuarHib6Y_37IQZv0SM3SllD55L0GtA4aVW8wTxYTONJbuoawvRuvb0L_zrhGYqky7gkWf3FcirPRewnQB65ivooqA1B9AgoU_jOsGUrSFfm0W1zAB5ifkbq-D6r_enkubRtXlS54z2hUjbRXCvybpqgdxqAmHZl6sXxsUau19GQyoqHTcHIJ9TmuqWzE4ZHdVuvXfzEsU3iJdRx1d4yFKaWBI4"/>
</div>
</div>
<!-- Microphone Setting -->
<div class="space-y-sm">
<label class="font-label-sm text-label-sm text-on-surface-variant px-1">Microphone Input</label>
<div class="flex items-center gap-md bg-surface-container-lowest p-md rounded-lg border border-outline-variant/30 focus-within:border-primary transition-colors">
<span class="material-symbols-outlined text-on-surface-variant">mic</span>
<select class="bg-transparent border-none text-on-surface font-body-md w-full focus:ring-0 p-0">
<option>Shure MV7 Digital Mic</option>
<option>Built-in Microphone</option>
</select>
</div>
<div class="h-1.5 w-full bg-surface-container-high rounded-full overflow-hidden">
<div class="h-full bg-primary w-[45%] shadow-[0_0_10px_#4fdbc8] animate-pulse"></div>
</div>
</div>
</div>
</div>
</div>
<!-- Right Column: History & Interests -->
<div class="lg:col-span-8 space-y-lg">
<!-- Interests Section -->
<div class="glass-card rounded-xl p-lg">
<div class="flex justify-between items-center mb-md">
<h4 class="font-label-md text-label-md font-bold text-primary flex items-center gap-sm">
<span class="material-symbols-outlined">interests</span>
              Discovery Preferences
            </h4>
<button class="text-primary hover:underline font-label-md text-label-md flex items-center gap-xs">
<span class="material-symbols-outlined text-[16px]">add_circle</span>
              Add New
            </button>
</div>
<p class="text-body-md font-body-md text-on-surface-variant mb-lg">These tags help our algorithm match you with like-minded safety-verified individuals.</p>
<div class="flex flex-wrap gap-sm">
<span class="px-md py-sm bg-secondary/10 border border-secondary/20 text-secondary rounded-xl font-label-md text-label-md flex items-center gap-sm hover:bg-secondary/20 cursor-pointer transition-colors group">
              Product Design
              <span class="material-symbols-outlined text-[14px] opacity-50 group-hover:opacity-100 transition-opacity">close</span>
</span>
<span class="px-md py-sm bg-secondary/10 border border-secondary/20 text-secondary rounded-xl font-label-md text-label-md flex items-center gap-sm hover:bg-secondary/20 cursor-pointer transition-colors group">
              Cybersecurity
              <span class="material-symbols-outlined text-[14px] opacity-50 group-hover:opacity-100 transition-opacity">close</span>
</span>
<span class="px-md py-sm bg-secondary/10 border border-secondary/20 text-secondary rounded-xl font-label-md text-label-md flex items-center gap-sm hover:bg-secondary/20 cursor-pointer transition-colors group">
              AI Ethics
              <span class="material-symbols-outlined text-[14px] opacity-50 group-hover:opacity-100 transition-opacity">close</span>
</span>
<span class="px-md py-sm bg-secondary/10 border border-secondary/20 text-secondary rounded-xl font-label-md text-label-md flex items-center gap-sm hover:bg-secondary/20 cursor-pointer transition-colors group">
              Web3 Architecture
              <span class="material-symbols-outlined text-[14px] opacity-50 group-hover:opacity-100 transition-opacity">close</span>
</span>
<span class="px-md py-sm bg-secondary/10 border border-secondary/20 text-secondary rounded-xl font-label-md text-label-md flex items-center gap-sm hover:bg-secondary/20 cursor-pointer transition-colors group">
              Jazz Music
              <span class="material-symbols-outlined text-[14px] opacity-50 group-hover:opacity-100 transition-opacity">close</span>
</span>
<span class="px-md py-sm bg-primary/10 border border-primary/40 text-primary rounded-xl font-label-md text-label-md flex items-center gap-sm hover:bg-primary/20 cursor-pointer transition-colors">
<span class="material-symbols-outlined text-[18px]">add</span>
              Expand Interests
            </span>
</div>
</div>
<!-- Connection History -->
<div class="glass-card rounded-xl overflow-hidden flex flex-col h-[500px]">
<div class="p-lg border-b border-outline-variant/10 flex items-center justify-between bg-surface-container-low/50">
<div>
<h4 class="font-label-md text-label-md font-bold text-primary flex items-center gap-sm">
<span class="material-symbols-outlined">history</span>
                Recent Connections
              </h4>
<p class="text-label-sm font-label-sm text-on-surface-variant">Anonymized for your privacy &amp; safety.</p>
</div>
<button class="material-symbols-outlined text-on-surface-variant hover:text-error transition-colors p-sm rounded-full hover:bg-error/10">delete_sweep</button>
</div>
<div class="flex-grow overflow-y-auto custom-scrollbar">
<!-- Table Header -->
<div class="grid grid-cols-12 px-lg py-sm text-label-sm font-label-sm text-on-surface-variant border-b border-outline-variant/10 uppercase tracking-tighter">
<div class="col-span-5">Identity Hash</div>
<div class="col-span-3 text-center">Duration</div>
<div class="col-span-4 text-right">Timestamp</div>
</div>
<!-- List Item 1 -->
<div class="grid grid-cols-12 px-lg py-md items-center hover:bg-surface-container-high/40 transition-colors border-b border-outline-variant/5">
<div class="col-span-5 flex items-center gap-md">
<div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center border border-outline-variant/20">
<span class="material-symbols-outlined text-primary">person</span>
</div>
<div>
<div class="font-label-md text-label-md text-on-surface font-mono">User_7x391k</div>
<div class="text-label-sm text-on-surface-variant">Matching: Design • Jazz</div>
</div>
</div>
<div class="col-span-3 text-center font-body-md text-body-md text-on-surface-variant">
                12:45
              </div>
<div class="col-span-4 text-right">
<div class="font-label-md text-label-md text-on-surface">Today</div>
<div class="text-label-sm text-on-surface-variant">2:14 PM</div>
</div>
</div>
<!-- List Item 2 -->
<div class="grid grid-cols-12 px-lg py-md items-center hover:bg-surface-container-high/40 transition-colors border-b border-outline-variant/5">
<div class="col-span-5 flex items-center gap-md">
<div class="w-10 h-10 rounded-full bg-gradient-to-br from-tertiary/20 to-primary/20 flex items-center justify-center border border-outline-variant/20">
<span class="material-symbols-outlined text-tertiary">person</span>
</div>
<div>
<div class="font-label-md text-label-md text-on-surface font-mono">User_4w819z</div>
<div class="text-label-sm text-on-surface-variant">Matching: Cybersec</div>
</div>
</div>
<div class="col-span-3 text-center font-body-md text-body-md text-on-surface-variant">
                03:12
              </div>
<div class="col-span-4 text-right">
<div class="font-label-md text-label-md text-on-surface">Yesterday</div>
<div class="text-label-sm text-on-surface-variant">11:02 PM</div>
</div>
</div>
<!-- List Item 3 -->
<div class="grid grid-cols-12 px-lg py-md items-center hover:bg-surface-container-high/40 transition-colors border-b border-outline-variant/5">
<div class="col-span-5 flex items-center gap-md">
<div class="w-10 h-10 rounded-full bg-gradient-to-br from-secondary/20 to-primary/20 flex items-center justify-center border border-outline-variant/20">
<span class="material-symbols-outlined text-secondary">person</span>
</div>
<div>
<div class="font-label-md text-label-md text-on-surface font-mono">User_9p225m</div>
<div class="text-label-sm text-on-surface-variant">Matching: AI Ethics</div>
</div>
</div>
<div class="col-span-3 text-center font-body-md text-body-md text-on-surface-variant">
                24:10
              </div>
<div class="col-span-4 text-right">
<div class="font-label-md text-label-md text-on-surface">Oct 24, 2024</div>
<div class="text-label-sm text-on-surface-variant">8:30 AM</div>
</div>
</div>
<!-- List Item 4 -->
<div class="grid grid-cols-12 px-lg py-md items-center hover:bg-surface-container-high/40 transition-colors border-b border-outline-variant/5">
<div class="col-span-5 flex items-center gap-md">
<div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center border border-outline-variant/20 opacity-50">
<span class="material-symbols-outlined text-on-surface-variant">person</span>
</div>
<div>
<div class="font-label-md text-label-md text-on-surface font-mono">User_1a2b3c</div>
<div class="text-label-sm text-on-surface-variant">Matching: Web3</div>
</div>
</div>
<div class="col-span-3 text-center font-body-md text-body-md text-on-surface-variant">
                01:45
              </div>
<div class="col-span-4 text-right">
<div class="font-label-md text-label-md text-on-surface">Oct 23, 2024</div>
<div class="text-label-sm text-on-surface-variant">1:15 PM</div>
</div>
</div>
<!-- List Item 5 -->
<div class="grid grid-cols-12 px-lg py-md items-center hover:bg-surface-container-high/40 transition-colors">
<div class="col-span-5 flex items-center gap-md">
<div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center border border-outline-variant/20 opacity-50">
<span class="material-symbols-outlined text-on-surface-variant">person</span>
</div>
<div>
<div class="font-label-md text-label-md text-on-surface font-mono">User_z9y8x7</div>
<div class="text-label-sm text-on-surface-variant">General Discovery</div>
</div>
</div>
<div class="col-span-3 text-center font-body-md text-body-md text-on-surface-variant">
                05:59
              </div>
<div class="col-span-4 text-right">
<div class="font-label-md text-label-md text-on-surface">Oct 22, 2024</div>
<div class="text-label-sm text-on-surface-variant">10:45 PM</div>
</div>
</div>
</div>
<!-- Bottom Summary -->
<div class="p-md bg-surface-container-lowest/50 border-t border-outline-variant/10 text-center">
<span class="text-label-sm font-label-sm text-on-surface-variant italic">Showing 5 of 124 encrypted connection records.</span>
</div>
</div>
<!-- Safety Shield Indicator -->
<div class="glass-card rounded-xl p-lg bg-primary/5 border-primary/20 flex items-center gap-lg">
<div class="w-16 h-16 rounded-full bg-primary/20 flex items-center justify-center text-primary shrink-0">
<span class="material-symbols-outlined text-4xl" style="font-variation-settings: 'FILL' 1;">security</span>
</div>
<div>
<h5 class="font-headline-md text-headline-md text-on-surface">Safe Connection Shield Active</h5>
<p class="font-body-md text-body-md text-on-surface-variant">Your history and identity are protected by 256-bit end-to-end encryption. No video data is ever stored on our servers.</p>
</div>
</div>
</div>
</div>
</main>
<!-- Footer -->
<footer class="bg-surface-container-lowest dark:bg-surface-container-lowest w-full py-xl mt-auto border-t border-outline-variant/20 flat no shadows">
<div class="flex flex-col md:flex-row justify-between items-center px-margin-desktop gap-md w-full max-w-7xl mx-auto">
<div class="flex flex-col items-center md:items-start gap-xs">
<span class="font-headline-sm text-headline-sm font-black text-on-surface">SafeLink Video</span>
<span class="font-label-sm text-label-sm font-body-md text-body-md text-on-surface-variant opacity-60">© 2024 SafeLink Video. All rights reserved.</span>
</div>
<div class="flex flex-wrap justify-center gap-lg">
<a class="text-on-surface-variant font-body-md text-body-md hover:text-primary underline decoration-2 underline-offset-4 transition-all duration-300" href="#">Safety Guidelines</a>
<a class="text-on-surface-variant font-body-md text-body-md hover:text-primary underline decoration-2 underline-offset-4 transition-all duration-300" href="#">Terms of Service</a>
<a class="text-on-surface-variant font-body-md text-body-md hover:text-primary underline decoration-2 underline-offset-4 transition-all duration-300" href="#">Support</a>
<a class="text-on-surface-variant font-body-md text-body-md hover:text-primary underline decoration-2 underline-offset-4 transition-all duration-300" href="#">Privacy Policy</a>
</div>
</div>
</footer>
<script>
    // Simple micro-interactions
    document.querySelectorAll('.glass-card').forEach(card => {
      card.addEventListener('mouseenter', () => {
        card.style.transform = 'translateY(-2px)';
        card.style.transition = 'transform 0.3s ease';
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = 'translateY(0px)';
      });
    });

    // Simulated Mic Level
    const micBar = document.querySelector('.h-full.bg-primary');
    setInterval(() => {
      const width = Math.floor(Math.random() * (60 - 30 + 1)) + 30;
      micBar.style.width = width + '%';
    }, 150);
  </script>
</body></html>